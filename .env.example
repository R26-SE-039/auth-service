PORT=3001

# JWT Configuration
AUTH_SECRET=CHANGE_ME_IN_PRODUCTION_USE_LONG_RANDOM_STRING
AUTH_ACCESS_TOKEN_TTL_MINUTES=120
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_LONG_RANDOM_STRING
JWT_EXPIRES_IN=2h

# Refresh Token Configuration
REFRESH_TOKEN_SECRET=CHANGE_ME_IN_PRODUCTION_DIFFERENT_FROM_JWT_SECRET
REFRESH_TOKEN_TTL_DAYS=7

# PostgreSQL Connection
DATABASE_URL=postgresql://user:password@localhost:5433/user_db

# CORS
AUTH_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# App Base URL (used for invite links in emails)
APP_BASE_URL=http://localhost:5173

# Email / SMTP Configuration
# Leave SMTP_HOST empty in development to use Ethereal (fake email - see server logs for preview URL)
# In production, fill these in with your real SMTP provider (e.g. SendGrid, SES, Mailgun)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@nextgenqa.local
